# App info
NEXT_PUBLIC_APP_NAME=KERP


# Port d'exposition du frontend
FRONTEND_PORT=3000

# URL publique du frontend (utilisée dans les headers CORS)
PUBLIC_URL=http://localhost:3000

# URL du backend Spring Boot
# En local : http://localhost:8080
# En production : https://votre-backend.com
BACKEND_URL=http://localhost:8081

# Nginx - limite taille upload (doit correspondre au backend)
NGINX_MAX_FILE_SIZE=50m

# Nginx - timeouts (en secondes)
NGINX_PROXY_READ_TIMEOUT=300
NGINX_PROXY_CONNECT_TIMEOUT=75
NGINX_PROXY_SEND_TIMEOUT=300
